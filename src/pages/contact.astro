---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = (await getEntry('contact', 'contact'))!.data;
const site = (await getEntry('site', 'site'))!.data;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const f = page.form;
---
<Base title={page.title} description={page.description}>
  <section class="section">
    <div class="container">
      <h1>{page.heading}</h1>
      <p class="lede">{page.intro}</p>
      <p>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> ·
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>

  <div class="container contact">
    <form class="card contact__form" data-demo-form>
      <h2>{f.heading}</h2>
      <div class="contact__row">
        <label>
          {f.nameLabel}
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          {f.companyLabel}
          <input name="company" type="text" autocomplete="organization" required />
        </label>
      </div>
      <div class="contact__row">
        <label>
          {f.emailLabel}
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          {f.phoneLabel}
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
      </div>
      <label>
        {f.serviceLabel}
        <select name="service" required>
          <option value="" disabled selected>{f.servicePlaceholder}</option>
          {services.map((s) => <option value={s.id}>{s.data.title}</option>)}
          <option value="other">{f.otherOption}</option>
        </select>
      </label>
      <label>
        {f.messageLabel}
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button class="button" type="submit">{f.submitLabel}</button>
      <p class="contact__success" role="status" hidden>{f.successMessage}</p>
    </form>

    <div>
      <h2 class="contact__depots-heading">{page.depotsHeading}</h2>
      {site.depots.map((depot) => (
        <div class="depot">
          <h3>{depot.name}</h3>
          <address>
            {depot.address.map((line) => <span>{line}<br /></span>)}
          </address>
          <p><a href={`tel:${depot.phone.replace(/\s/g, '')}`}>{depot.phone}</a></p>
        </div>
      ))}
    </div>
  </div>
</Base>

<script>
  // Demo only: no form backend yet. Show the thank-you message instead of sending.
  document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.querySelector<HTMLElement>('[role="status"]')!.hidden = false;
      form.reset();
    });
  });
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    align-items: start;
    padding-bottom: var(--space-24);
  }
  @media (max-width: 52rem) {
    .contact { grid-template-columns: minmax(0, 1fr); }
  }
  .contact__form { background: var(--color-surface); border: 0; display: grid; gap: var(--space-4); }
  .contact__row { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  label { display: grid; gap: var(--space-1); font-weight: var(--weight-medium); }
  input,
  select,
  textarea {
    font: inherit;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  input:focus,
  select:focus,
  textarea:focus { border-color: var(--color-primary); outline: 2px solid var(--color-primary); outline-offset: 0; }
  .contact__form .button { justify-self: start; }
  .contact__success {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--color-primary);
    background: var(--color-bg);
  }
  .contact__depots-heading { font-size: var(--text-xl); }
  .depot { border-top: var(--border-width) solid var(--color-border); padding-top: var(--space-4); margin-top: var(--space-4); }
  .depot h3 { font-size: var(--text-base); margin-bottom: var(--space-2); }
  .depot address { font-style: normal; color: var(--color-text-muted); margin-bottom: var(--space-2); }
</style>
