---
// Landing page template. Each JSON file in src/content/campaigns becomes /campaigns/<file-name>.
// The agent creates new landing pages by adding a JSON file, never by editing this template.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const campaigns = await getCollection('campaigns');
  return campaigns.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'campaigns'>;
}
const page = Astro.props.entry.data;
---
<Base title={page.title} description={page.description}>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        {page.hero.eyebrow && <span class="eyebrow">{page.hero.eyebrow}</span>}
        <h1>{page.hero.heading}</h1>
        <p class="lede">{page.hero.text}</p>
        <a class="button" href={page.hero.cta.href}>{page.hero.cta.label}</a>
      </div>
      <Picture image={page.hero.image} ratio="4 / 3" />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container intro">
      {page.intro.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__head">{page.benefitsHeading}</h2>
      <div class="grid">
        {page.benefits.map((b) => (
          <div class="card">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container proof">
      <p class="proof__value">{page.proof.value}</p>
      <div>
        <p class="proof__label">{page.proof.label}</p>
        <p>{page.proof.text}</p>
      </div>
    </div>
  </section>

  {page.faq && (
    <section class="section">
      <div class="container faq">
        <h2>{page.faq.heading}</h2>
        {page.faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <CtaBand cta={page.cta} />
</Base>

<style>
  .hero { padding: var(--space-16) 0 var(--space-24); }
  .hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .hero .button { margin-top: var(--space-4); }
  .intro { max-width: calc(var(--text-width) + 2 * var(--space-6)); }
  .intro p:last-child { margin-bottom: 0; }
  .card p { color: var(--color-text-muted); margin: 0; }
  .proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }
  .proof__value { font-size: var(--text-3xl); font-weight: var(--weight-bold); line-height: var(--leading-tight); margin: 0; }
  .proof__label { font-size: var(--text-lg); font-weight: var(--weight-bold); margin-bottom: var(--space-1); }
  .proof p:last-child { color: var(--color-text-muted); margin: 0; }
  .faq { max-width: calc(var(--text-width) + 2 * var(--space-6)); }
  details { border-top: var(--border-width) solid var(--color-border); padding: var(--space-4) 0; }
  details:last-child { border-bottom: var(--border-width) solid var(--color-border); }
  summary { font-weight: var(--weight-medium); cursor: pointer; }
  details p { color: var(--color-text-muted); margin: var(--space-2) 0 0; }
</style>
