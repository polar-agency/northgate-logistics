---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'site'))!.data;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="header__nav">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: var(--space-4) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .header__logo {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text);
    text-decoration: none;
  }
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: var(--weight-medium);
    border-bottom: 2px solid transparent;
  }
  .header__nav a:hover { color: var(--color-text); }
  .header__nav a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-primary);
  }
</style>
